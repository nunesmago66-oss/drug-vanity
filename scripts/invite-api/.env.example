# Backend (VPS). No secrets are needed.
PORT=8787
HOST=0.0.0.0
# Official site origins, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://verified-url.lovable.app
# 1 only when behind your own reverse proxy (Caddy/Nginx) that sets X-Forwarded-For.
TRUST_PROXY=1
# Max lookups waiting in the global queue (each visitor holds at most one).
MAX_QUEUE=10
# Optional extra spacing between Discord requests (ms); never below the built-in floor.
MIN_GAP_MS=

# Frontend (Lovable project environment / build), points the site at this backend:
# VITE_INVITE_API_BASE_URL=https://api.your-domain.com
